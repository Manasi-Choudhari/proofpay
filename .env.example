# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
# Use a US sandbox business account for the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI providers: tried in AI_PROVIDER_ORDER; at least one key is required
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_ORDER=groq,gemini

# Sign-in codes by email (Gmail: smtp.gmail.com, port 465, an App Password from myaccount.google.com/apppasswords)
# Leave empty to show codes on screen in "sandbox inbox" mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Random string used to sign session cookies
SESSION_SECRET=

# Escrow policy
AUTO_RELEASE_CONFIDENCE=0.75
# Pays the freelancer's PayPal email via the Payouts API after each capture
PAYOUTS_ENABLED=true
PLATFORM_FEE_PCT=5
