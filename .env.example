# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI provider: Gemini is used first (supports screenshots); Groq is the fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Escrow policy
AUTO_RELEASE_CONFIDENCE=0.75
# Set to true to also pay the freelancer's PayPal email via the Payouts API after each capture
PAYOUTS_ENABLED=false
PLATFORM_FEE_PCT=5
